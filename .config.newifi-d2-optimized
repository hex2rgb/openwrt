#
# OpenWrt Configuration for Newifi D2 (32MB Flash)
# Target: xray-core + WireGuard + Performance Optimized
# Hardware: MT7621A @ 880MHz, 512MB RAM, 32MB Flash
#

# =================================================
# Target System
# =================================================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_d-team_newifi-d2=y

# =================================================
# Image Configuration
# =================================================
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_IMAGES_INCLUDE_SDK=y

# =================================================
# LuCI Web Interface
# =================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# =================================================
# PassWall2 - Transparent Proxy Solution
# =================================================
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_ipt2socks=y
CONFIG_PACKAGE_microsocks=y

# =================================================
# Proxy Core - Xray (Modern Protocol + Low CPU)
# =================================================
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_xray-geosite=y
CONFIG_PACKAGE_xray-geoip=y
# Disable other proxy cores to save space
# CONFIG_PACKAGE_v2ray-core is not set
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_hysteria is not set
# CONFIG_PACKAGE_trojan-go is not set

# =================================================
# WireGuard VPN - Fast & Secure
# =================================================
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_kmod-crypto-lib-chacha20poly1305=y
CONFIG_PACKAGE_kmod-crypto-lib-curve25519=y
CONFIG_PACKAGE_kmod-udptunnel4=y
CONFIG_PACKAGE_kmod-udptunnel6=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-app-wireguard=y

# =================================================
# DNS / Network - Smart DNS + Full Features
# =================================================
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_ip-full=y

# iptables - Full Support for TProxy/Transparent Proxy
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-conntrack=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_iptables-mod-nat-extra=y
CONFIG_PACKAGE_iptables-mod-iprange=y

# iptables Kernel Modules - CRITICAL for TProxy
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-ipt-nat-extra=y

# =================================================
# SSL / TLS Support
# =================================================
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libopenssl-conf=y

# =================================================
# Wi-Fi - Full Support (no issues)
# =================================================
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# =================================================
# SSH - Maintenance Access
# =================================================
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_openssh-client=y
CONFIG_PACKAGE_openssh-sftp-server=y
# CONFIG_PACKAGE_dropbear is not set

# =================================================
# IPv6 Support (Recommended)
# =================================================
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# =================================================
# Base System Utilities
# =================================================
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_zlib=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libc=y

# =================================================
# Performance & Stability
# =================================================
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_iwinfo-lua=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y

# =================================================
# Disable Unnecessary / Heavy Packages
# =================================================
# Disable Docker (too heavy for 32MB)
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_luci-app-docker is not set

# Disable other proxy cores (we use xray)
# CONFIG_PACKAGE_mosdns is not set
# CONFIG_PACKAGE_v2ray-plugin is not set

# Disable adblock (smartdns handles this better)
# CONFIG_PACKAGE_adblock is not set

# Disable development tools
# CONFIG_PACKAGE_ttyd is not set
# CONFIG_PACKAGE_nano is not set
# CONFIG_PACKAGE_vim is not set

# Disable USB storage (optional, can enable if needed)
# CONFIG_PACKAGE_usbutils is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_kmod-fs-vfat is not set
# CONFIG_PACKAGE_kmod-fs-ntfs is not set

# Disable unnecessary network services
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set

# =================================================
# Build Options (Performance)
# =================================================
CONFIG_DEVEL=y
CONFIG_CCACHE=y
